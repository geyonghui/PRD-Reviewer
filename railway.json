{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd prd-reviewer && npm ci && npm run build"
  },
  "deploy": {
    "startCommand": "cd prd-reviewer && npm run start -- -p $PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
